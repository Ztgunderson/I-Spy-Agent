# Copy to .env (gitignored) and fill in. Read by scripts/config.sh; the environment overrides it.

# Remote host that serves the decision models over SSH (user@host or an ~/.ssh/config alias).
JETSON=
# GGUF scratch folder and llama-server binaries on that host. Single-quote paths with ~ so they
# expand on the remote host, not here.
JETSON_DIR='~/narc-gguf'
JETSON_LLAMA_SERVER=llama-server
# Newer llama.cpp build for models the default one fails to load (Clef 27B, Vega-27B).
JETSON_LLAMA_SERVER_ALT=

# This machine: llama-server binary, extra shared-library folders for it, GGUF download folder.
LLAMA_SERVER=llama-server
LLAMA_LIB_PATH=
MODELS_DIR=models
# Checkout of NARCBench (generation/stego.py), used by scripts/narc_generate.sh.
NARCBENCH_DIR=
# Script that serves Clef-flash on :8097 (from the decision-layer workspace).
CLEF_SERVE=../handyman/scripts/serve_clef.sh
# Local copy of Cloudflare/clef-flash for stegowatch.clef_lora.
CLEF_FLASH_DIR=models/clef-flash-hf

# Hugging Face token, only for gated or rate-limited downloads.
HF_TOKEN=
